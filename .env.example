# Sentinel NVR — environment configuration
# Copy this file to .env and edit as needed.
# All paths below are optional — if omitted, they derive from ARGUS_DATA_ROOT.

# ---- Security --------------------------------------------------------------
# Required: generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARGUS_SECRET_KEY=change-me-generate-a-real-key

# ---- Data root (all paths derive from this if not set individually) --------
# Windows installer default: C:\Sentinel
# Linux installer default:   /opt/sentinel
# Dev (unset): auto-detected as 3 dirs above sentinel/config.py
# ARGUS_DATA_ROOT=C:\Sentinel

# ---- Individual data paths (uncomment to override) -------------------------
# ARGUS_RECORDINGS_DIR=C:\Sentinel\recordings
# ARGUS_EVENTS_DIR=C:\Sentinel\events
# ARGUS_DB_PATH=C:\Sentinel\data\sentinel.db
# ARGUS_LOG_DIR=C:\Sentinel\logs

# ---- Tool paths (uncomment to override; defaults derive from tools subdir) -
# FFMPEG_PATH=C:\Sentinel\tools\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\Sentinel\tools\ffmpeg\bin\ffprobe.exe
# GO2RTC_PATH=C:\Sentinel\tools\go2rtc.exe

# ---- Server ----------------------------------------------------------------
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8080

# ---- go2rtc ----------------------------------------------------------------
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

# ---- Recording -------------------------------------------------------------
SEGMENT_SECONDS=120
DEFAULT_RECORD_MODE=motion-only
RETENTION_MAX_AGE_DAYS=30
RETENTION_FREE_SPACE_FLOOR_PCT=10

# ---- Detection -------------------------------------------------------------
DETECT_FPS=2
